# MLflow tracking server image: the stock image lacks the PostgreSQL driver.
# Build: docker build -f docker/Dockerfile.mlflow -t mlflow-server:sha-<commit> docker/
FROM python:3.12-slim-trixie
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir mlflow==3.15.2 psycopg2-binary==2.9.13 \
 && useradd --uid 1000 --create-home mlflow
USER 1000
EXPOSE 5000
